data/generated/
cache/
*.sqlite
*.sqlite-journal

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Generated by make gen (only eval/ reads it)
data/planted.json

# Parallel Claude sessions' worktrees
.claude/worktrees/
